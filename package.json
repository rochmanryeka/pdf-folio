{
  "name": "folio-pdf",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5186 --strictPort",
    "build": "tsc -b && vite build && node scripts/verify-css.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4186 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e.mjs",
    "test:annotations": "node scripts/annotations-e2e.mjs",
    "test:compact": "node scripts/compact-e2e.mjs",
    "test:interactions": "node scripts/interactions-e2e.mjs",
    "test:text-fidelity": "node scripts/text-fidelity-e2e.mjs",
    "deploy": "npm run build && npx --yes netlify-cli@latest deploy --prod --no-build --dir=dist --site=e40ac12e-0415-4100-ae3d-2d4446af0fa9"
  },
  "dependencies": {
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-rnd": "^10.5.2",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.1.1",
    "@tailwindcss/oxide": "^4.1.17",
    "@tailwindcss/postcss": "^4.1.17",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^27.2.0",
    "prettier": "^3.10.1",
    "puppeteer-core": "^25.17.0",
    "tailwindcss": "^4.1.17",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.9"
  }
